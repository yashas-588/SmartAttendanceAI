rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is a teacher
    function isTeacher() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isTeacher());
      allow write: if request.auth != null && (request.auth.uid == userId || isTeacher());
    }

    match /attendance/{docId} {
      // Students can read their own attendance, Teachers can read all
      allow read: if request.auth != null && (request.auth.uid == resource.data.student_uid || request.auth.uid == resource.data.studentId || isTeacher());
      // ONLY the backend API (Admin SDK) can write to attendance
      allow write: if false;
    }

    match /sessions/{sessionId} {
      // Any authenticated user can read active sessions
      allow read: if request.auth != null;
      // Only Teachers can create/update sessions
      allow write: if isTeacher();
    }

    match /students/{studentId} {
      // Students can read their own data, Teachers can read all
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isTeacher());
      // Teachers manage students. Students can write/update their own student record.
      allow write: if isTeacher() || (request.auth != null && request.auth.uid == resource.data.uid);
    }
    
    match /attendance_logs/{logId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || isTeacher());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentId;
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
  }
}
