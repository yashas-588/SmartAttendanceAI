rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is a teacher
    function isTeacher() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isTeacher());
      allow create: if request.auth != null && request.auth.uid == userId && (request.resource.data.role == 'student' || isTeacher());
      allow update: if request.auth != null && (isTeacher() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'accountType', 'accountStatus'])));
      allow delete: if isTeacher();
    }

    match /attendance/{docId} {
      // Students can read their own attendance, Teachers can read all
      allow read: if request.auth != null && (request.auth.uid == resource.data.student_uid || request.auth.uid == resource.data.studentId || isTeacher());
      // ONLY the backend API (Admin SDK) can write to attendance
      allow write: if false;
    }

    match /sessions/{sessionId} {
      // Any authenticated user can read active sessions
      allow read: if request.auth != null;
      // Only Teachers can create/update sessions
      allow write: if isTeacher();
    }

    match /students/{studentId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isTeacher());
      allow create: if isTeacher();
      allow update: if isTeacher() || (
        request.auth != null 
        && request.auth.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['descriptors', 'email', 'name', 'usn', 'department', 'semester'])
      );
      allow delete: if isTeacher();
    }
    
    match /attendance_logs/{logId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || isTeacher());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentId;
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
  }
}
