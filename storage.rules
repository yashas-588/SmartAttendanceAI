rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /student_documents/{studentId}/{allPaths=**} {
      // Allow read: if authenticated and (is the student themselves OR is a teacher/admin)
      allow read: if request.auth != null && (
        request.auth.uid == studentId ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin']
      );
      
      // Allow write (upload, rename, delete): only if authenticated and is a teacher/admin
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin']
      );
    }
  }
}
