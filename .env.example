# ─── Smart AI Attendance — Environment Variables Example ──────────────────────────────
#
# SETUP:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Fill in real values
#   3. NEVER commit .env to git (it is in .gitignore)
#
# EMAIL (Resend — free tier: 3,000 emails/month)
#   Sign up at https://resend.com → API Keys → Create Key
#   For free sandbox: keep EMAIL_FROM as onboarding@resend.dev
#   For production: add & verify your domain in Resend dashboard
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
EMAIL_FROM=onboarding@resend.dev
PORTAL_URL=https://your-firebase-project.web.app

# ─── HMAC token secret (change this in production!) ──────────────────────────
LIVENESS_SECRET=replace-with-a-secure-random-hmac-secret

# ─── Flask config ─────────────────────────────────────────────────────────────
FLASK_PORT=5005
FLASK_DEBUG=true
